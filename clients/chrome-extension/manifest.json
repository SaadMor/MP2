{
  "manifest_version": 3,
  "name": "Darija Side Translator",
  "version": "1.0.0",
  "description": "Translate selected text to Darija using your Jakarta REST endpoint.",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["http://localhost:8080/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Darija Translator"
  }
}
